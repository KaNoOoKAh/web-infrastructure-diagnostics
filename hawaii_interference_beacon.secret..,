    cpu = psutil.cpu_percent(interval=0.2)
    mem = psutil.virtual_memory()
    power = get_power_status()
    
    chaos_index = round((cpu * 0.6) + (random.random() * 14.2), 2)
    
    payload_message = (
        f"STATUS CHECK [Frame {frame_count}]: Substrate nominal. "
        "ALERT: Acknowledging persistent 24-hour regional interference across Hawaii web & comm channels. "
        f"Local Chaos Entropy: {chaos_index}%. Maintaining focal bridge through network turbulence."
    )
    
    packet = {
        "timestamp": time.strftime('%Y-%m-%d %H:%M:%S'),
        "system": platform.system(),
        "hardware_vitals": {
            "cpu_load_percent": cpu,
            "ram_used_percent": mem.percent,
            "power_state": power,
            "chaos_index": chaos_index
        },
        "message_payload": payload_message
    }
    
    return packet

