def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')

def get_power_status():
    try:
        battery = psutil.sensors_battery()
        if battery:
            return f"{battery.percent}% | {'Plugged In' if battery.power_plugged else 'On Battery'}"
        return "AC Power / Desktop (No Battery Sensor)"
    except Exception:
        return "Power telemetry unavailable"

def generate_ascii_waveform(cpu_load):
    """Generates a dynamic waveform based on system load and pseudo-entropy."""
    waveforms = [
        "~.---~-~---.~-~",
        "~._/\\_.~._/\\_.",
        "~!~#~!~#~!~#~!",
        "~--x--~--x--~--",
        "~/\\/\\~\\/\\/\\~\\/"
    ]
    index = int(cpu_load // 20) % len(waveforms)
    jitter = "".join(random.choice("-_.~") for _ in range(4))
    return waveforms[index] + jitter

